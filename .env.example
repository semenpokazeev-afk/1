# Arbiter Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ARBITER_SECRET_KEY=dev-secret-key-change-in-production

# Storage
DATABASE_URL=sqlite+aiosqlite:///./arbiter.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/arbiter

# Multi-Armed Bandit Hyperparameters
MAB_DEFAULT_STRATEGY=auto
MAB_EXPLORATION_RATE=0.15
MAB_DECAY_HALF_LIFE_HOURS=72.0
MAB_MIN_TRIALS=5

# Quality & Timeout Thresholds
CONSENSUS_TIMEOUT_SECONDS=15.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0

# LLM Provider API Keys (Leave blank to use MockProvider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default Provider & Fallback
DEFAULT_FALLBACK_PROVIDER=mock
